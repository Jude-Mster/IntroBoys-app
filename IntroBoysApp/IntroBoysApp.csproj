<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 10 and newer -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IntroBoys.App</RootNamespace>
    <AssemblyName>IntroBoysApp</AssemblyName>

    <!-- A new package name: the old guild app (com.blacklistintroboys.app) was signed with a different key, so this one
         installs next to it instead of failing; members delete the old one afterwards. -->
    <ApplicationId>com.blacklistintroboys.guild</ApplicationId>
    <ApplicationTitle>BLACKLIST</ApplicationTitle>
    <!-- The build sets the number from the GitHub run, so every build installs over the last one. -->
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <ApplicationDisplayVersion>1.3.6</ApplicationDisplayVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <!-- JSON is read and written by hand (JsonDocument / Utf8JsonWriter), so trimming is safe -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Custom Tabs and Trusted Web Activity: opens the guild site in Chrome's app mode (GuildActivity.cs) -->
    <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.8.0.9" />
    <!-- on-phone text recognition (Ocr.cs): reads the position, the map name and the teleport list from the screen -->
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.6" />
    <!-- the text recognition pulls in androidx compose annotations twice (an Android and a plain Java copy of the same classes):
         keep only the Android one, or the build stops with "Type androidx.compose.runtime.Immutable is defined multiple times" -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.10.0.1" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <Target Name="DropDuplicateComposeAnnotations" BeforeTargets="_CompileToDalvik;_CompileJava;_ResolveLibraryProjectImports">
    <ItemGroup>
      <AndroidJavaLibrary Remove="@(AndroidJavaLibrary)" Condition="$([System.String]::Copy('%(Identity)').Contains('runtime-annotation-jvm'))" />
      <AndroidLibrary Remove="@(AndroidLibrary)" Condition="$([System.String]::Copy('%(Identity)').Contains('runtime-annotation-jvm'))" />
    </ItemGroup>
  </Target>

</Project>
